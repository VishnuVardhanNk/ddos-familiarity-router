    {
      "id": 5,
      "type": "stat",
      "title": "Focus: macro-F1",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ddos-pg"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 4,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select ((2 * sum(attacks_caught)) / nullif(2 * sum(attacks_caught) + sum(false_alarms) + sum(attacks_missed), 0) + (2 * sum(benign_passed)) / nullif(2 * sum(benign_passed) + sum(attacks_missed) + sum(false_alarms), 0)) / 2 as macro_f1 from live_scores where model = '$model'"
        }
      ]
    },
