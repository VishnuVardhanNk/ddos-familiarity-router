    {
      "id": 13,
      "type": "table",
      "title": "Share of each attack type that was missed (%), per model",
      "gridPos": {
        "h": 9,
        "w": 13,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ddos-pg"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/random_forest|neural_network|decision_tree|gradient_boosted_trees|logistic_regression/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "orange",
                      "value": 5
                    },
                    {
                      "color": "red",
                      "value": 20
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "attack_flows"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select label_family as attack_type, case when label_family = 'Portmap' then 'no, new attack' else 'yes' end as seen_in_training, sum(attacks_caught + attacks_missed) filter (where model = 'random_forest') as attack_flows, round(100.0 * sum(attacks_missed) filter (where model = 'random_forest') / nullif(sum(attacks_caught + attacks_missed) filter (where model = 'random_forest'), 0), 2) as random_forest, round(100.0 * sum(attacks_missed) filter (where model = 'neural_network') / nullif(sum(attacks_caught + attacks_missed) filter (where model = 'neural_network'), 0), 2) as neural_network, round(100.0 * sum(attacks_missed) filter (where model = 'decision_tree') / nullif(sum(attacks_caught + attacks_missed) filter (where model = 'decision_tree'), 0), 2) as decision_tree, round(100.0 * sum(attacks_missed) filter (where model = 'gradient_boosted_trees') / nullif(sum(attacks_caught + attacks_missed) filter (where model = 'gradient_boosted_trees'), 0), 2) as gradient_boosted_trees, round(100.0 * sum(attacks_missed) filter (where model = 'logistic_regression') / nullif(sum(attacks_caught + attacks_missed) filter (where model = 'logistic_regression'), 0), 2) as logistic_regression from live_scores where label_family <> 'Benign' group by 1 order by 3 desc"
        }
      ]
    },
