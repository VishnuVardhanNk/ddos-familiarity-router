    {
      "id": 10,
      "type": "timeseries",
      "title": "Running macro-F1 per model",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ddos-pg"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0.4,
          "max": 1,
          "decimals": 4,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "with per_batch as (select model, batch_id, max(processed_at) as time, sum(attacks_caught) as tp, sum(attacks_missed) as fn, sum(false_alarms) as fp, sum(benign_passed) as tn from live_scores group by model, batch_id), running as (select model, time, sum(tp) over w as tp, sum(fn) over w as fn, sum(fp) over w as fp, sum(tn) over w as tn from per_batch window w as (partition by model order by batch_id)) select time, model as metric, ((2 * tp) / nullif(2 * tp + fp + fn, 0) + (2 * tn) / nullif(2 * tn + fn + fp, 0)) / 2 as macro_f1 from running where $__timeFilter(time) order by time"
        }
      ]
    },
