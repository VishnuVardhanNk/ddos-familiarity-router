      "options": {
        "mode": "markdown",
        "content": "## Real-time DDoS detection\n**Pipeline:** Kafka → Spark Structured Streaming → 5 Spark MLlib models → PostgreSQL → Grafana &nbsp;&nbsp;|&nbsp;&nbsp; **Experiment:** every model was trained on capture day 1 (2019-01-12) and is scoring capture day 2 (2019-03-11), replayed in time order &nbsp;&nbsp;|&nbsp;&nbsp; **Focus model:** `$model`"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Flows scored",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ddos-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
