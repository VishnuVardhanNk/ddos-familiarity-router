      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select x, case when kind = 'a' then y else -1000 end as \"Day 1 traffic\", case when kind = 'b' then y else -1000 end as \"Day 2, familiar\", case when kind = 'c' then y else -1000 end as \"Day 2, unfamiliar\", case when kind = 'd' then y else -1000 end as \"Cluster centres\", case when kind = 'e' then y else -1000 end as \"Distance to nearest centre\", case when kind = 'f' then y else -1000 end as \"Selected connection\" from (select x, y, 'a' as kind from gate_points where day = 'day 1' union all select x, y, 'b' from gate_points where day = 'day 2' and not unfamiliar union all select x, y, 'c' from gate_points where day = 'day 2' and unfamiliar union all select centre_x, centre_y, 'd' from gate_centres union all select x + (centre_x - x) * step / 60.0, y + (centre_y - y) * step / 60.0, 'e' from gate_examples, generate_series(1, 59) as step where name = '$flow' union all select x + 0.5 * ring / 7.0 * cos(angle / 28.0 * 2 * pi()), y + 1.4 * ring / 7.0 * sin(angle / 28.0 * 2 * pi()), 'f' from gate_examples, generate_series(0, 7) as ring, generate_series(1, 28) as angle where name = '$flow') points"
        }
      ]
    },
