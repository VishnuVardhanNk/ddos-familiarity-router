          "editorMode": "code",
          "rawSql": "select to_char(least(floor(distance / 0.8), 24) * 0.8, 'FM990.0') as distance, count(*) filter (where day = 'day 1') as \"Day 1\", count(*) filter (where day = 'day 2' and not unfamiliar) as \"Day 2, familiar\", count(*) filter (where day = 'day 2' and unfamiliar) as \"Day 2, unfamiliar\" from gate_points group by least(floor(distance / 0.8), 24) order by least(floor(distance / 0.8), 24)"
